<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_iap_page">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/_16sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/hero_image"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="412:641"
                android:adjustViewBounds="true"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@drawable/iap_sheet" />




                <TextView
                    android:id="@+id/title_access"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    app:layout_constraintBottom_toTopOf="@id/intro_trial_subtitle"
                    android:text="@string/text_get_full_access_to_screen_mirroring"
                    android:textColor="#F4D188"
                    android:textSize="@dimen/_20ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/intro_trial_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_marginBottom="@dimen/_24sdp"
                    android:fontFamily="@font/inter"
                    app:layout_constraintBottom_toTopOf="@id/btn_save"
                    android:gravity="center"
                    android:text="@string/text_iap_trial_auto_renewal"
                    android:textColor="#F4F4F4"
                    android:textSize="@dimen/_10ssp" />

                <TextView
                    android:id="@+id/btn_save"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_46sdp"
                    app:layout_constraintBottom_toTopOf="@id/no_payment_row"
                    android:layout_marginHorizontal="@dimen/_28sdp"
                    android:layout_marginBottom="@dimen/_28sdp"
                    android:background="@drawable/bg_btn_iap"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:text="@string/text_iap_try_for_free"
                    android:textColor="#101010"
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/no_payment_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@id/bottom"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/_15sdp"
                        android:layout_height="@dimen/_15sdp"
                        android:src="@drawable/ic_iap_check" />

                    <TextView
                        android:id="@+id/title_free"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:fontFamily="@font/inter"
                        android:gravity="center"
                        android:text="@string/text_iap_no_payment_now"
                        android:textColor="#F4F4F4"
                        android:textSize="@dimen/_9ssp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_14sdp"
                    android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_restore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:gravity="center"
                        android:text="@string/text_restore"
                        android:textColor="#9D9DA3"
                        android:textSize="@dimen/_8ssp" />

                    <TextView
                        android:id="@+id/text_term"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_22sdp"
                        android:fontFamily="@font/inter"
                        android:gravity="center"
                        android:text="@string/text_iap_terms_of_service"
                        android:textColor="#9D9DA3"
                        android:textSize="@dimen/_8ssp" />

                    <TextView
                        android:id="@+id/text_policy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_22sdp"
                        android:fontFamily="@font/inter"
                        android:gravity="center"
                        android:text="@string/text_iap_privacy_policy"
                        android:textColor="#9D9DA3"
                        android:textSize="@dimen/_8ssp" />
                </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <ImageView
        android:id="@+id/btn_close"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_margin="@dimen/_12sdp"
        android:background="@drawable/bg_iap_close"
        android:padding="@dimen/_7sdp"
        android:src="@drawable/ic_close_iap"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
