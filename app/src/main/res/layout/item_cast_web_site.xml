<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cast_web_site_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/_6sdp">

    <TextView
        android:id="@+id/site_logo"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_26sdp"
        android:background="@drawable/bg_site_generic"
        android:autoSizeMaxTextSize="@dimen/_11ssp"
        android:autoSizeMinTextSize="@dimen/_6ssp"
        android:autoSizeStepGranularity="@dimen/_1ssp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/white"
        android:textSize="@dimen/_11ssp"
        android:textStyle="bold"
        tools:text="TED" />

    <TextView
        android:id="@+id/site_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:ellipsize="end"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="@dimen/_9ssp"
        tools:text="TED" />
</LinearLayout>
