<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="@dimen/_20sdp">

    <TextView
        android:id="@+id/tv_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:text="@string/text_connected_device"
        android:textColor="@color/white"
        android:textSize="@dimen/_16ssp"
        android:gravity="center"
        android:layout_marginBottom="@dimen/_16sdp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1dp"
        android:background="#2C2C2E"
        android:layout_marginBottom="@dimen/_16sdp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/_8sdp">

        <ImageView
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:src="@drawable/ic_cast"
            android:padding="@dimen/_8sdp"
            android:background="@drawable/bg_circle_primary"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_12sdp">

            <TextView
                android:id="@+id/tv_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="Device Name"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_device_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="Connected"
                android:textColor="#999999"
                android:textSize="@dimen/_12ssp"
                android:layout_marginTop="@dimen/_2sdp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <View
            android:id="@+id/connection_dot"
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_10sdp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#84FF6A" />

    </LinearLayout>

    <TextView
        android:id="@+id/btn_disconnect"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:background="@drawable/bg_disconnect_button"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:text="@string/text_disconnect"
        android:textColor="@color/white"
        android:textSize="@dimen/_14ssp" />

    <TextView
        android:id="@+id/btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/bg_button_secondary"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:text="@string/text_cancel"
        android:textColor="@color/white"
        android:textSize="@dimen/_14ssp" />

</LinearLayout>
