<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_12sdp"
    android:layout_marginBottom="@dimen/_10sdp"
    android:background="@drawable/bg_iptv_row"
    android:orientation="vertical"
    android:padding="@dimen/_12sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_movie_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            tools:text="1. The Dark Knight" />

        <TextView
            android:id="@+id/tv_movie_match"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_26sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/bg_movie_advisor_result_badge"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="@dimen/_58sdp"
            android:paddingHorizontal="@dimen/_8sdp"
            android:textColor="#F4C567"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            tools:text="92%" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_movie_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:fontFamily="@font/inter"
        android:includeFontPadding="false"
        android:textColor="#B7B7BD"
        android:textSize="@dimen/_9ssp"
        tools:text="2008 - Movie - TVmaze 9.0 - 120 min" />

    <TextView
        android:id="@+id/tv_movie_genres"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:fontFamily="@font/inter"
        android:includeFontPadding="false"
        android:textColor="#F4C567"
        android:textSize="@dimen/_9ssp"
        tools:text="Action, Crime, Drama" />

    <TextView
        android:id="@+id/tv_movie_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:ellipsize="end"
        android:fontFamily="@font/inter"
        android:lineSpacingExtra="@dimen/_2sdp"
        android:maxLines="4"
        android:textColor="#D7D7DC"
        android:textSize="@dimen/_9ssp"
        tools:text="Short movie summary goes here." />

    <TextView
        android:id="@+id/tv_movie_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:fontFamily="@font/inter"
        android:lineSpacingExtra="@dimen/_2sdp"
        android:textColor="#8F8F96"
        android:textSize="@dimen/_8ssp"
        tools:text="Matches Action and has a strong rating." />
</LinearLayout>
