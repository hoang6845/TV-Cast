<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MyMaterialSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/white</item>
        <item name="trackTint">@color/track_switch_color</item>
    </style>

    <style name="CastWebMediaRouteButtonTheme">
        <item name="android:colorControlNormal">@color/white</item>
        <item name="colorControlNormal">@color/white</item>
    </style>

    <style name="TvRemoteSmallButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_cast_youtube_nav_button</item>
        <item name="android:clickable">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">@dimen/_8sdp</item>
        <item name="android:paddingEnd">@dimen/_8sdp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_9ssp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TvRemoteGridCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">@dimen/_4sdp</item>
    </style>

    <style name="TvRemoteDpadButton" parent="TvRemoteGridCell">
        <item name="android:background">@drawable/bg_cast_youtube_nav_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_11ssp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MovieAdvisorTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ThemeOverlay.App.PopupMenu"
        parent="ThemeOverlay.Material3.Light">

        <!-- Nền popup -->
        <item name="android:colorBackground">#141416</item>

        <!-- Màu chữ -->
        <item name="android:textColor">#ffffff</item>

        <!-- Màu khi nhấn -->
        <item name="colorControlHighlight">#252528</item>
    </style>
    <style name="ThemeOverlay.App.CastDialog"
        parent="ThemeOverlay.Material3.MaterialAlertDialog">

        <!-- Màu nền dialog -->
        <item name="colorSurface">#141416</item>

        <!-- Màu tiêu đề -->
        <item name="materialAlertDialogTitleTextStyle">
            @style/App.CastDialog.Title
        </item>

        <!-- Màu chữ danh sách -->
        <item name="materialAlertDialogBodyTextStyle">
            @style/App.CastDialog.Body
        </item>
    </style>

    <style name="App.CastDialog.Title"
        parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="App.CastDialog.Body"
        parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
